# Copy to .env and fill in real values. .env is gitignored - keep it that way.
#
# This one file feeds both phases of a deployment:
#   - build time: Vite inlines every VITE_* value into the bundle
#   - run time:   docker-compose passes the same values to the container, where
#                 docker/15-render-nginx-conf.sh turns the two URLs below into the
#                 nginx Content-Security-Policy connect-src allowlist
#
# Because they are inlined into client-side JS, no VITE_* value is secret - never
# put an API key or client secret in one. They are kept out of git to avoid
# publishing infrastructure hostnames, not to protect credentials.
#
# These are the complete set that is read anywhere: src/config/keycloak.js,
# src/properties/ApplicationProperties.jsx, and vite.config.js. The five below are
# required; VITE_APP_TITLE at the bottom is optional.

# Backend API. Must be absolute and http(s); its origin is added to connect-src.
# Use https in production - an http API called from an https page is blocked as
# mixed content.
VITE_API_BASE_URI=https://api.your-domain.com/izzybot

# Where this UI is served from. Used to build the auth-failure redirect.
VITE_UI_BASE_URI=https://your-domain.com

# Keycloak server root, no /realms suffix. Its origin is added to connect-src.
# The client must also list https://your-domain.com/ under Valid Redirect URIs and
# https://your-domain.com under Web Origins, or the PKCE token exchange fails CORS
# and login loops.
VITE_KEYCLOAK_URL=https://auth.your-domain.com
VITE_KEYCLOAK_REALM=your-realm
VITE_KEYCLOAK_CLIENT_ID=your-client-id

# Optional. Browser tab title. Applied at build time by the applicationTitlePlugin
# in vite.config.js, which rewrites <title> in index.html - so index.html's own
# value is only the fallback. Defaults to "Solesonic LLM" when unset or blank.
VITE_APP_TITLE=Solesonic LLM

# Container timezone.
TZ=UTC
